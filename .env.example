DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Read-only source for the Warehouse snapshot. Use a role that can only SELECT
# public.workers, public.schedule and public.vacations (see DEPLOYMENT.md).
SUPABASE_DATABASE_URL=
FLEXPEDIA_API_TOKEN=
# Minutes between automatic Flexpedia/Supabase syncs; 0 turns them off.
SYNC_INTERVAL_MINUTES=60
# OSRM server for road distances. The public demo server is fine for a few
# hundred workers; self-host OSRM with the Netherlands extract for more.
ROUTING_BASE_URL=https://router.project-osrm.org
APP_BACKEND_URL=
BACKEND_PROXY_SECRET=
SESSION_SECRET=
INITIAL_ADMIN_EMAIL=dispatcher@local
# Used only for the very first sign-in; remove it afterwards.
INITIAL_ADMIN_PASSWORD=
GEOCODER_USER_AGENT=InternationalAtWork/1.0 (https://example.com/contact)
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=
# Daily verified backups (docker/backup.sh).
BACKUP_AT=03:30
BACKUP_KEEP_DAYS=14
BACKUP_DIR=./backups
# Optional dead-man switch, e.g. a healthchecks.io URL pinged after each backup.
BACKUP_PING_URL=
